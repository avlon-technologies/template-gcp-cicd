output "cloud_run_service_name" {
  description = "Name of the Cloud Run service, for gcloud commands and the pipeline's SERVICE_NAME variable."
  value       = google_cloud_run_v2_service.this.name
}

output "cloud_run_service_uri" {
  description = "Default run.app URI of the service's ingress endpoint. Generated by Cloud Run and not derivable from the service name, which is why the deploy workflow asks the API for it rather than constructing it."
  value       = google_cloud_run_v2_service.this.uri
}

output "cloud_run_service_id" {
  description = "Fully qualified Cloud Run service resource ID, for IAM bindings and load-balancer backends."
  value       = google_cloud_run_v2_service.this.id
}

output "cloud_run_service_location" {
  description = "Region the service runs in, for the pipeline's GCP_REGION variable."
  value       = google_cloud_run_v2_service.this.location
}

output "runtime_service_account_email" {
  description = "Email of the identity the container runs as, for the pipeline's RUNTIME_SERVICE_ACCOUNT variable and for IAM grants by the caller."
  value       = local.runtime_service_account_email
}

output "runtime_service_account_member" {
  description = "The runtime identity as an IAM member string (`serviceAccount:<email>`), for granting it access to registries, secrets, and databases."
  value       = "serviceAccount:${local.runtime_service_account_email}"
}
